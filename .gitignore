# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Repo root only. The Next.js app has its own .gitignore in web/, which covers
# node_modules, .next, next-env.d.ts and the generated Prisma client.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# Python worker
worker/__pycache__/
worker/.venv/
worker/*.pyc
