# Copy this file to ".env" and fill in real values. This file is tracked by git,
# so never put a secret in it.
#
# When adding a variable, add it to the schema in "/src/env.js" too or it will
# not be readable from server code.

# Prisma. Same database the Python worker in /worker writes to.
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=""

# Next Auth v5.
# Generate with: npx auth secret
# NOTE: this replaced NEXTAUTH_SECRET in the v4 -> v5 upgrade. NEXTAUTH_URL is
# gone entirely - v5 infers the URL, and uses VERCEL_URL when deployed.
AUTH_SECRET=""

# Next Auth Google Provider. Passed explicitly in src/server/auth/config.ts, so
# the names stay the same as they were under v4.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# No Twitch credentials needed. Video metadata and VOD comments both come from
# the public gql.twitch.tv endpoint using the web-player Client-ID, and that
# happens in the worker, not here.
