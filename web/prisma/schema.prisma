// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    // Prisma 6 wants an explicit output. `src/server/db.ts` imports from here,
    // and `postinstall` regenerates it, so the directory is not committed.
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Table names are mapped to snake_case because the Python worker in /worker
// talks to this database over raw SQL. Column names stay camelCase, so the
// worker quotes them ("contentOffsetSeconds").

/// Lifecycle of an ingest job. The Next.js app only ever creates QUEUED rows;
/// every other transition is owned by the Python worker.
enum JobStatus {
    QUEUED
    RUNNING
    DONE
    FAILED
}

/// The work queue. One row per Twitch VOD we have been asked to index.
/// The progress bar in the web app is rendered straight off this row.
model VideoJob {
    id String @id @default(cuid())
    /// Twitch VOD id. BigInt, not Int: ids passed 2^31 in 2026, so INT4 rejects
    /// every current VOD with "Unable to fit integer value into an INT4".
    /// The tRPC layer converts to and from `number` - see the video router.
    videoId BigInt    @unique
    status  JobStatus @default(QUEUED)

    /// 0-100. Written by the worker as it walks the VOD timeline.
    progress        Float @default(0)
    commentsIndexed Int   @default(0)

    /// Filled in by the worker once it has fetched metadata, so the UI can show
    /// the title while indexing is still running.
    lengthSeconds Int?
    title         String?
    streamer      String?

    /// Populated on FAILED so the UI can say what went wrong.
    error String?

    attempts Int @default(0)

    /// claimedAt marks the moment a worker took the job. heartbeatAt is bumped
    /// during the run so a stalled job can be detected and requeued.
    claimedAt   DateTime?
    heartbeatAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status, createdAt])
    @@map("video_jobs")
}

model Example {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("examples")
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@map("accounts")
}

model Channel {
    id       String    @id @default(cuid())
    streamer String    @unique
    avatar   String?
    seId     String?
    /// Plain scalar list, not a relation. `videos` below is the real link.
    videoIds String[]
    videos   Video[]
    terms    Term[]
    hashtags Hashtag[]

    @@map("channels")
}

model Emote {
    id      String  @id @default(cuid())
    emojiId String  @unique
    name    String
    gif     Boolean
    type    String
    url1    String?
    url2    String?
    url3    String?
    terms   Term[]

    @@map("emotes")
}

model Video {
    id        String @id @default(cuid())
    channelId String
    /// See VideoJob.videoId - BigInt for the same reason.
    videoId      BigInt        @unique
    url          String
    description  String
    duration     String
    title        String
    thumbnail    String
    streamer     String
    views        Int
    likes        Int
    language     String
    date         String
    createdAt    String
    comments     Msg[]
    Cards        Card[]
    commentCards CommentCard[]

    complete Boolean @default(false)
    Channel  Channel @relation(fields: [channelId], references: [id])

    @@map("videos")
}

model Hashtag {
    id        String @id @default(cuid())
    channelId String

    hashtag String
    amount  Int

    Channel Channel @relation(fields: [channelId], references: [id])

    @@map("hashtags")
}

model Term {
    id        String @id @default(cuid())
    channelId String
    /// FK onto Emote.emojiId. Not unique on its own - two channels can both
    /// use the same emote, they just get one Term row each.
    emojiId   String
    term      String
    amount    Int
    type      String

    Channel Channel @relation(fields: [channelId], references: [id])
    Emote   Emote?  @relation(fields: [emojiId], references: [emojiId])

    @@unique([channelId, emojiId])
    @@index([term])
    @@map("terms")
}

model Card {
    id          String        @id @default(cuid())
    vidId       String
    keyword     String
    interval    Int
    likes       Int
    sum         Int?
    avg         Int?
    max         Int?
    min         Int?
    url         String?
    CommentCard CommentCard[]
    Video       Video         @relation(fields: [vidId], references: [id])

    @@map("cards")
}

model CommentCard {
    id                   String     @id @default(cuid())
    timestamp            String
    contentOffsetSeconds Int
    count                Int
    likes                Int
    finder               String?
    /// Scalar list of user ids, kept for the fast `liked.includes(userId)` check.
    /// `users` below is the queryable relation for the same fact.
    liked                String[]
    last60               DateTime[]
    second               Int?
    last30               DateTime[]
    minute               Int?
    last24               DateTime[]
    day                  Int?
    last7                DateTime[]
    week                 Int?
    cardId               String
    vidId                String
    /// Scalar list of Msg ids. Deliberately not a relation so the worker and
    /// comment router can bulk-insert cards with createMany.
    msgIds               String[]
    users                User[]     @relation("CommentCardLikes")
    card                 Card       @relation(fields: [cardId], references: [id])
    video                Video      @relation(fields: [vidId], references: [id])

    @@map("comment_cards")
}

model Msg {
    id                   String @id @default(cuid())
    vidId                String
    message              String
    commentId            String @unique
    commenter            String?
    contentOffsetSeconds Int
    Video                Video  @relation(fields: [vidId], references: [id])

    @@index([vidId, contentOffsetSeconds])
    @@map("msgs")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("sessions")
}

model User {
    id            String        @id @default(cuid())
    username      String?       @unique
    name          String?
    email         String?       @unique
    emailVerified DateTime?
    image         String?
    likes         Int           @default(0)
    /// Scalar mirror of `likedCards`, kept so existing filter/push logic works.
    cardIds       String[]
    likedCards    CommentCard[] @relation("CommentCardLikes")
    accounts      Account[]
    sessions      Session[]

    @@map("users")
}

model VerificationToken {
    id         String   @id @default(cuid())
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")
}
