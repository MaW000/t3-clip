# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.
#
# Copy this file to .env and fill in real values. Never put secrets in this file
# - it is tracked by git.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL=""

# Next Auth
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://next-auth.js.org/configuration/options#secret
NEXTAUTH_SECRET=""

NEXTAUTH_URL="http://localhost:3000"

# Next Auth Google Provider
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# No Twitch credentials needed. Video metadata and VOD comments both come from
# the public gql.twitch.tv endpoint using the web-player Client-ID.
